# Railway Deployment Environment Variables
# Copy this to .env for local development

# Database (SQLite for local dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./thematic_analysis.db

# Redis (optional for local dev, required for Celery background jobs)
REDIS_URL=redis://localhost:6379/0

# Fireworks AI API (required for AI-guided analysis)
FIREWORKS_API_KEY=your_fireworks_api_key_here
FIREWORKS_MODEL=accounts/fireworks/models/qwen3p6-plus

# File storage directories
UPLOADS_DIR=./data/uploads
REPORTS_DIR=./data/reports
MAPS_DIR=./data/maps

# App settings
DEBUG=false
